# GitHub App
WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=123456

# Google Gemini API (free tier)
GEMINI_API_KEY=AIza...

# Optional: path to private key file (defaults to ./private-key.pem)
# On Render set to /etc/secrets/private-key.pem
PRIVATE_KEY_PATH=private-key.pem

# Flask (optional)
FLASK_ENV=production